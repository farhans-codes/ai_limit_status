{
  "manifest_version": 3,
  "name": "AI Limit Status Browser Bridge",
  "version": "0.1.0",
  "description": "Provides opted-in ChatGPT and Claude browser sessions to the local AI Limit Status app.",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
